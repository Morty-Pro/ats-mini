bool checkLicense()
{
  uint64_t id = ESP.getEfuseMac();

  for (size_t i = 0; i < sizeof(LICENSED_IDS)/sizeof(LICENSED_IDS[0]); i++)
  {
      if (id == LICENSED_IDS[i])
          return true;
  }

  return false;
}

